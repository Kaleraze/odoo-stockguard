<odoo>
    <record id="module_category_stockguard" model="ir.module.category">
        <field name="name">StockGuard</field>
        <field name="description">Lot control and warehouse approval workflow</field>
        <field name="sequence">20</field>
    </record>

    <record id="group_warehouse_user" model="res.groups">
        <field name="name">Warehouse User</field>
        <field name="category_id" ref="module_category_stockguard"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can raise approval requests but cannot decide on them.</field>
    </record>

    <record id="group_warehouse_approver" model="res.groups">
        <field name="name">Warehouse Approver</field>
        <field name="category_id" ref="module_category_stockguard"/>
        <field name="implied_ids" eval="[(4, ref('group_warehouse_user'))]"/>
        <field name="comment">Can approve or reject the approval levels assigned to them.</field>
    </record>

    <record id="group_warehouse_manager" model="res.groups">
        <field name="name">Warehouse Manager</field>
        <field name="category_id" ref="module_category_stockguard"/>
        <field name="implied_ids" eval="[(4, ref('group_warehouse_approver'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full control, including deleting requests and overriding approval levels.</field>
    </record>

    <record id="warehouse_approval_request_company_rule" model="ir.rule">
        <field name="name">Warehouse Approval Request: multi-company</field>
        <field name="model_id" ref="model_warehouse_approval_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
